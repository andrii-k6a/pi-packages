{
  "name": "@andrii-k6a/pi-dynamic-workflows",
  "version": "0.1.0",
  "description": "Pi extension for Claude-Code-style dynamic workflow orchestration with durable, resumable, observable runs on Pi Durable.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "workflow",
    "agents"
  ],
  "files": [
    "src",
    "dist",
    "types",
    "examples",
    "tsconfig.build.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./workflow": {
      "types": "./types/workflow.d.ts"
    }
  },
  "pi": {
    "extensions": [
      "./src/dynamic-workflows.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "acorn": "^8.16.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
