{
  "name": "pi-packages",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Extensions, skills, prompts, and themes for pi, the AI coding agent",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck",
    "check:ci": "biome ci . && tsc -p tsconfig.json --noEmit",
    "test:code-rot-cleaner": "python3 -m unittest discover -s skills/code-rot-cleaner/tests -p 'test_*.py'",
    "test": "vitest run"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-packages",
    "pi-extensions",
    "pi-coding-agent"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-feedback/src/feedback.ts",
      "./packages/pi-head/src/head.ts",
      "./packages/pi-inspect/src/inspect.ts",
      "./packages/pi-generative-ui/src/generative-ui.ts",
      "./packages/pi-tmux-branch/src/tmux-branch.ts",
      "./packages/pi-dynamic-workflows/src/dynamic-workflows.ts",
      "./packages/pi-caffeinate/src/caffeinate.ts",
      "./packages/pi-ask-question/src/ask-question.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
